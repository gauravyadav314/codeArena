# CodeArena Global Stack Configuration
# Copy this file to .env before starting docker-compose

# Backend Configuration
PORT=5001
NODE_ENV=production
CLIENT_ORIGIN=http://localhost:5173

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:codearenasecret@postgres:5432/codearena?schema=public
POSTGRES_DB=codearena
POSTGRES_USER=postgres
POSTGRES_PASSWORD=codearenasecret

# Cache & Queues (Redis)
REDIS_URL=redis://redis:6379

# Authentication & Security
JWT_SECRET=codearena-production-super-secret-jwt-key-32chars
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=codearena-production-super-secret-refresh-key-32chars
REFRESH_TOKEN_EXPIRES_IN=7d

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:5001
