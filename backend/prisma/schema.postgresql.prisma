// CodeArena Prisma Schema - Production PostgreSQL Specification
// Includes native enums, indexes, cascade rules, and security fields.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
  MODERATOR
}

enum RatingTier {
  Grandmaster
  Master
  Expert
  Specialist
  Apprentice
  Novice
}

enum MatchStatus {
  WAITING
  IN_PROGRESS
  COMPLETED
  DRAW
  CANCELLED
}

enum Difficulty {
  Easy
  Medium
  Hard
}

enum Category {
  ArraysAndHashing
  TwoPointers
  DynamicProgramming
  Trees
  Graphs
  LinkedList
  Stack
  BinarySearch
}

enum Language {
  javascript
  python
  typescript
  cpp
  java
}

enum Verdict {
  ACCEPTED
  WRONG_ANSWER
  TIME_LIMIT_EXCEEDED
  MEMORY_LIMIT_EXCEEDED
  RUNTIME_ERROR
  COMPILATION_ERROR
}

enum RatingChangeReason {
  MATCH_WIN
  MATCH_LOSS
  MATCH_DRAW
  PROFILE_SYNC
  ADMIN_ADJUSTMENT
}

model User {
  id               String          @id @default(uuid())
  username         String          @unique
  email            String          @unique
  passwordHash     String?
  refreshTokenHash String?
  role             UserRole        @default(USER)
  name             String?
  avatarUrl        String?
  bio              String?
  arenaRating      Int             @default(1200)
  ratingTier       RatingTier      @default(Novice)
  wins             Int             @default(0)
  losses           Int             @default(0)
  draws            Int             @default(0)
  streak           Int             @default(0)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  profile          Profile?
  matchesAsPlayer1 Match[]         @relation("Player1Matches")
  matchesAsPlayer2 Match[]         @relation("Player2Matches")
  wonMatches       Match[]         @relation("WonMatches")
  submissions      Submission[]
  ratingHistories  RatingHistory[]

  @@index([arenaRating(sort: Desc)])
  @@index([username])
  @@index([email])
}

model Profile {
  id                  String    @id @default(uuid())
  userId              String    @unique
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  leetcodeUsername    String?
  leetcodeRating      Int       @default(0)
  leetcodeSolved      Int       @default(0)
  leetcodeEasy        Int       @default(0)
  leetcodeMedium      Int       @default(0)
  leetcodeHard        Int       @default(0)
  codeforcesHandle    String?
  codeforcesRating    Int       @default(0)
  codeforcesRank      String?
  codeforcesMaxRating Int       @default(0)
  codechefHandle      String?
  codechefRating      Int       @default(0)
  codechefStars       String?
  compositeScore      Int       @default(0)
  lastSyncedAt        DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

model Problem {
  id             String       @id @default(uuid())
  title          String
  slug           String       @unique
  difficulty     Difficulty   @default(Easy)
  category       Category     @default(ArraysAndHashing)
  description    String
  starterCode    String
  testCases      String       // JSON string fallback
  timeLimitMs    Int          @default(2000)
  memoryLimitMb  Int          @default(256)
  acceptanceRate Float        @default(68.5)
  createdAt      DateTime     @default(now())

  matches        Match[]
  submissions    Submission[]
  testCaseItems  TestCase[]

  @@index([slug])
  @@index([difficulty])
  @@index([category])
}

model TestCase {
  id          String   @id @default(uuid())
  problemId   String
  problem     Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)
  input       String
  expected    String
  isHidden    Boolean  @default(false)
  order       Int      @default(0)
  explanation String?
  createdAt   DateTime @default(now())

  @@index([problemId, isHidden])
  @@index([problemId, order])
}

model Match {
  id                  String          @id @default(uuid())
  code                String          @unique
  player1Id           String
  player1             User            @relation("Player1Matches", fields: [player1Id], references: [id])
  player2Id           String?
  player2             User?           @relation("Player2Matches", fields: [player2Id], references: [id])
  problemId           String
  problem             Problem         @relation(fields: [problemId], references: [id])
  status              MatchStatus     @default(WAITING)
  winnerId            String?
  winner              User?           @relation("WonMatches", fields: [winnerId], references: [id])
  player1Score        Int             @default(0)
  player2Score        Int             @default(0)
  player1RatingBefore Int?
  player1RatingAfter  Int?
  player2RatingBefore Int?
  player2RatingAfter  Int?
  startedAt           DateTime?
  endedAt             DateTime?
  durationSeconds     Int             @default(900)
  createdAt           DateTime        @default(now())

  submissions         Submission[]
  ratingHistories     RatingHistory[]

  @@index([status])
  @@index([player1Id])
  @@index([player2Id])
  @@index([winnerId])
  @@index([createdAt(sort: Desc)])
}

model Submission {
  id          String   @id @default(uuid())
  matchId     String?
  match       Match?   @relation(fields: [matchId], references: [id], onDelete: SetNull)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  problemId   String
  problem     Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)
  language    Language @default(javascript)
  code        String
  status      Verdict  @default(WRONG_ANSWER)
  passedCount Int      @default(0)
  totalCount  Int      @default(0)
  runtimeMs   Int      @default(0)
  submittedAt DateTime @default(now())

  @@index([userId, submittedAt(sort: Desc)])
  @@index([problemId])
  @@index([matchId])
}

model RatingHistory {
  id           String             @id @default(uuid())
  userId       String
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  matchId      String?
  match        Match?             @relation(fields: [matchId], references: [id], onDelete: SetNull)
  ratingBefore Int
  ratingAfter  Int
  change       Int
  reason       RatingChangeReason @default(MATCH_RESULT)
  createdAt    DateTime           @default(now())

  @@index([userId, createdAt(sort: Desc)])
}

