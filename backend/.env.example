# Server Configuration
PORT=5001
NODE_ENV=development

# CORS Configuration
CLIENT_ORIGIN=http://localhost:5173

# Database Configuration (PostgreSQL for production, SQLite for local dev)
DATABASE_URL="file:./dev.db"

# JWT Authentication
JWT_SECRET="codearena-production-super-secret-jwt-key-32chars"
JWT_EXPIRES_IN="15m"
REFRESH_TOKEN_SECRET="codearena-production-super-secret-refresh-key-32chars"
REFRESH_TOKEN_EXPIRES_IN="7d"

# Redis Cache & BullMQ Queue
REDIS_URL="redis://127.0.0.1:6379"

# Rate Limiting
RATE_LIMIT_MAX_PER_MINUTE=60
